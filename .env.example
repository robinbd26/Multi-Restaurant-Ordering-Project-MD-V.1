# ─────────────────────────────────────────────────────────────
# MAD Delivery HQ — Next.js-only full-stack app
# Copy to .env.local (Next.js runtime) AND .env (Prisma CLI) for local dev:
#   cp .env.example .env.local && cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# Database — SQLite for local dev (zero setup).
# For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mad_delivery?schema=public"
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth secret — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="dev-only-change-me-please-generate-a-real-secret"

# Auth.js derives the current app origin from Host/X-Forwarded-* request headers.
# Keep AUTH_URL and NEXTAUTH_URL unset so login/logout work on every deployment
# URL. The reverse proxy must forward Host, X-Forwarded-Host and
# X-Forwarded-Proto.
AUTH_TRUST_HOST=true

# ── FILE UPLOADS ─────────────────────────────────────────────────────────
# Runtime upload directory (relative to the app cwd, or an absolute path).
# Files are stored HERE, not in public/, and served via the /api/uploads route
# — so uploads work in `next start` and survive restarts. In production point
# this at a PERSISTENT, WRITABLE disk (e.g. UPLOAD_DIR=/var/lib/mad/uploads).
UPLOAD_DIR=storage/uploads

# Optional: if set, uploaded-file URLs are built as
#   ${NEXT_PUBLIC_UPLOAD_BASE_URL}/<key>  (e.g. an S3/R2/CDN base).
# Leave empty to serve through the internal /api/uploads route.
NEXT_PUBLIC_UPLOAD_BASE_URL=

# Default Super Admin created by `npm run seed`.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@maddelivery.com
ADMIN_PASSWORD=Admin12345@##

# ── OPTIONAL — EXTERNAL INTEGRATIONS ─────────────────────────
# Every feature below has a working local/demo fallback; set a key to go live.
# The app runs fully without any of these.

# Google Maps — live rider pin + branch delivery-zone map.
# Without it: polished map placeholder + raw coordinates are shown.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OTP / SMS login (customer). Without it: username/password login is primary.
# SMS_PROVIDER=            # e.g. twilio | ssl_wireless | bulksmsbd
# SMS_API_KEY=
# SMS_SENDER_ID=

# ── WEB PUSH NOTIFICATIONS (WS-6.1) ──────────────────────────────────────
# Lock-screen alerts for riders (new delivery requests, announcements) and for
# customers (every order status update). Leave all three EMPTY and the app runs
# exactly as before: no service-worker subscription, no permission prompt, and
# the in-app DB notifications + bell keep working unchanged. Nothing crashes.
# A HALF-filled block is refused (with a server-log warning) rather than half
# working — all three are required together.
#
# Generate a key pair once, store it, and reuse it forever. Rotating the keys
# invalidates every stored subscription; browsers re-subscribe on their next
# visit automatically (lib/services/push.ts prunes the dead endpoints):
#   npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
# Contact address for the push service to reach you about your traffic. Must be
# a "mailto:" address or an "https:" URL — the VAPID spec requires one.
# VAPID_SUBJECT=mailto:ops@maddelivery.com
#
# The public key is served to the browser by GET /api/push, so it does NOT need
# a NEXT_PUBLIC_ copy. The private key never leaves the server.
# Push requires a SECURE origin: https in production, or localhost in dev
# (`next dev --experimental-https` if you need to test from a phone on the LAN).

# ── PAYMENT GATEWAY (WS-1.1) ─────────────────────────────────────────────
# bKash Tokenized Checkout. Leave everything below EMPTY and the app runs
# exactly as before: no "Pay online" button, and cash-on-delivery + the
# record-and-verify manual bKash flow keep working. Nothing crashes, and a
# HALF-filled block is refused (with a server-log warning) rather than half
# working — all four credentials are required together.
#
# Which rail is used. Only "bkash" is implemented; the driver seam in
# lib/services/payments.ts is ready for nagad | rocket | sslcommerz.
# PAYMENT_GATEWAY_PROVIDER=bkash
#
# Merchant credentials from your bKash merchant portal. NEVER commit real ones.
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
#
# API base URL, WITHOUT a trailing slash. Sandbox is the default when this is
# left empty — production must set the live URL explicitly, we never guess it:
#   sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
#   live:    https://tokenized.pay.bka.sh/v1.2.0-beta
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
#
# The customer is redirected back to these paths; they are built from the
# request's own host, so no callback URL needs configuring here. Whitelist them
# with bKash if your merchant account requires it:
#   /api/payments/gateway/callback/order
#   /api/payments/gateway/callback/ramadan
# Every callback is re-verified server-side against bKash's payment/status and
# the amount is compared to the order total to the paisa before anything is
# marked paid, so a forged callback cannot settle an order.

# Server-side PDF/Excel export. Without it: CSV export + browser print-to-PDF work.
# (No key needed for CSV; a PDF/XLSX lib or service is the only external piece.)

# File uploads — every uploaded image is auto-converted to WebP (sharp) and
# written to the runtime UPLOAD_DIR (see FILE UPLOADS above), served same-origin
# via /api/uploads. Allowed input: image/jpeg, image/png, image/webp, image/avif
# (max 5MB); final stored format is always .webp. For cloud storage (S3/R2),
# wire a provider in lib/http/upload.ts and set NEXT_PUBLIC_UPLOAD_BASE_URL +
# the credentials here.
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

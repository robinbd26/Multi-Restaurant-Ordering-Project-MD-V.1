# ─────────────────────────────────────────────────────────────
# MAD Delivery HQ — every env var the code reads. NAMES ONLY: never put real
# keys in this file (it is committed). Real values live in .env / .env.local,
# which are gitignored.
# Local setup: copy to BOTH .env (Prisma CLI) and .env.local (Next.js runtime):
#   cp .env.example .env && cp .env.example .env.local     (setup.bat does this)
# Lines starting with "#" are optional — uncomment and fill to turn a feature on.
# Anything left unset falls back to a working demo/local behaviour.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# Prisma database URL (SQLite for local dev; each developer has their own dev.db).
DATABASE_URL="file:./dev.db"

# Auth.js session-signing secret. Generate a real one: npx auth secret
# (the value below is a dev-only placeholder — never deploy with it).
AUTH_SECRET="dev-only-change-me-please-generate-a-real-secret"

# Lets Auth.js derive the app origin from Host/X-Forwarded-* headers (keep AUTH_URL / NEXTAUTH_URL unset).
AUTH_TRUST_HOST=true

# ── FILE UPLOADS ─────────────────────────────────────────────

# Runtime directory where uploaded images are written (must be persistent + writable in production).
UPLOAD_DIR=storage/uploads

# Optional CDN/S3 base URL for uploaded-file links; empty serves them via /api/uploads.
NEXT_PUBLIC_UPLOAD_BASE_URL=

# ── SEED (npm run seed) ──────────────────────────────────────

# Default Super Admin login created by the seed script.
ADMIN_USERNAME=
ADMIN_EMAIL=
# Super Admin password for the seed — required in production, and the seed refuses the published demo password there.
ADMIN_PASSWORD=

# ── MAPS (optional) ──────────────────────────────────────────

# Map tiles come from OpenStreetMap through Leaflet. Both values are read in the browser (NEXT_PUBLIC_*), so they are
# public and must never hold a secret. Leave empty to use the public OSM server, which has a usage policy and no uptime
# guarantee: point these at a tile provider before real traffic. Use {z}/{x}/{y} (and {s} for subdomains) in the URL.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Attribution shown on every map (HTML allowed); must match the tile provider. Empty = OpenStreetMap contributors.
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# ── SMS / OTP LOGIN (optional) ───────────────────────────────

# SMS gateway to use: bulksmsbd | ssl_wireless | twilio (unset = demo driver, OTP codes are not really sent).
# SMS_PROVIDER=
# API key for the chosen SMS gateway (the Auth Token when using twilio).
# SMS_API_KEY=
# Sender ID shown on the SMS (the From number when using twilio).
# SMS_SENDER_ID=
# Override the SMS gateway endpoint (each provider has a built-in default).
# SMS_API_URL=
# Twilio account SID (required when SMS_PROVIDER=twilio).
# TWILIO_ACCOUNT_SID=

# ── WEB PUSH (optional — all three VAPID vars are required together) ──

# VAPID public key for browser push (served to the browser by GET /api/push); generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY is SERVER-ONLY: signs push messages and must never reach the browser.
# VAPID_PRIVATE_KEY=
# Contact for the push service: a mailto: address or https: URL.
# VAPID_SUBJECT=

# ── ONLINE PAYMENTS (optional) ───────────────────────────────

# Which online gateway to use; only "bkash" is implemented (defaults to bkash).
# PAYMENT_GATEWAY_PROVIDER=
# bKash merchant credentials — all four are required together, SERVER-ONLY, never commit real ones.
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# bKash API base URL without trailing slash (empty = sandbox; production must set the live URL explicitly).
# BKASH_BASE_URL=
# Nagad credentials — read only to log a warning; online Nagad is NOT implemented (manual Nagad flow is used).
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_PRIVATE_KEY=
# NAGAD_PUBLIC_KEY=

# ── DEPLOYMENT / RUNTIME (optional) ──────────────────────────

# Alternate Next.js build output dir (defaults to .next).
# NEXT_DIST_DIR=
# Host and port used to build the site's own base URL for SEO links when nothing else is known.
# HOSTNAME=
# PORT=

# ── TESTS ONLY (Playwright e2e / perf checks — never set in production) ──

# Isolated SQLite file for the e2e server so tests never touch dev.db.
# E2E_DATABASE_URL=
# Upload directory the e2e server writes to.
# E2E_UPLOAD_DIR=
# Port the e2e production server listens on (default 3000).
# E2E_PORT=
# Base URL Playwright tests target (default http://localhost:<E2E_PORT>).
# PLAYWRIGHT_BASE_URL=
# Where Playwright writes per-run artifacts and the HTML report.
# E2E_OUTPUT_DIR=
# E2E_REPORT_DIR=
# Target server and login password for tests/performance-response.test.mjs.
# PERF_BASE_URL=
# PERF_TEST_PASSWORD=


# ── BARIKOI (address search + pin-to-address lookup) ─────────
# SERVER-ONLY: never prefix with NEXT_PUBLIC_. The browser calls our /api/geo/* routes, which call Barikoi.
# Account owner: AshMd. Dashboard: https://developer.barikoi.com (free tier, created Sep 2026).
# Details, what uses it and what happens when the quota runs out: docs/integrations.md.
# Empty = search and address prefill are off; customers can still drop a pin and type the address. Coverage never needs it.
BARIKOI_API_KEY=

{
  "name": "mad-delivery-hq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "node scripts/check-i18n-params.mjs",
    "seed": "tsx prisma/seed.ts",
    "images:convert": "node scripts/convert-images-to-webp.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:test:deploy": "node scripts/ensure-test-db.mjs && node scripts/with-test-db.mjs npx prisma migrate deploy",
    "seed:test": "node scripts/with-test-db.mjs --seed npm run seed",
    "test:unit": "node --import tsx --test tests/*.test.mts",
    "test:e2e:prepare": "npm run db:test:deploy && npm run seed:test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^2.4.3",
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^6.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}

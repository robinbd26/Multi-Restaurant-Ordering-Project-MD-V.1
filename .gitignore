# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local env / secret files — NEVER commit real secrets; copy .env.example instead
.env
.env.*
!.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma / SQLite dev database
/prisma/*.db
/prisma/*.db-journal

# Local uploads (user-generated)
/public/uploads/*
!/public/uploads/.gitkeep

# Runtime upload storage (served via /api/uploads from UPLOAD_DIR; created at
# runtime, must be a persistent writable dir in production)
/storage/


# Playwright
/test-results/
/test-results-e2e-gate/
/playwright-report/
/playwright-report-nf/
/playwright-report-e2e-gate/
/playwright/.cache/
/.playwright-mcp/
/.playwright-cli/
/ai_doc/
/static_design/

# dashboard visual-review captures (regenerated by 16-dashboard-visual.spec.ts)
/test-artifacts/
/test-results-nf/backups/

# Playwright artifacts (regenerated by test runs)
/output/
